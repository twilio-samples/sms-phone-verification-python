# Twilio Credentials
# Find these at https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Twilio Verify Service SID
# Create a Verify Service at https://console.twilio.com/us1/develop/verify/services
VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Flask secret key for session signing (generate a random string)
SECRET_KEY=your_secret_key_here

# Server port (optional, defaults to 5000)
PORT=5000
